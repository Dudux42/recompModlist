{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dudux42/recompModlist/schema/mod.schema.json",
  "title": "Gen1Recomp mod index entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "author", "version", "categories", "repo", "downloadURL"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "maxLength": 64 },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "author": { "type": "string", "minLength": 1, "maxLength": 64 },
    "summary": { "type": "string", "maxLength": 200 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+].*)?$" },
    "categories": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": { "enum": ["GAMEPLAY", "CONTENT", "BALANCE", "ART", "AUDIO", "UI", "QOL", "TRANSLATION", "TOTAL_CONVERSION", "LIBRARY", "TOOL", "OTHER"] } },
    "tags": { "type": "array", "maxItems": 8, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9 -]{0,23}$" } },
    "repo": { "type": "string", "pattern": "^https://" },
    "downloadURL": { "type": "string", "pattern": "^https://.*\\.zip$" },
    "api": { "type": "integer", "minimum": 1, "maximum": 2 },
    "game_version": { "type": "string", "maxLength": 64 },
    "games": { "type": "array", "uniqueItems": true, "items": { "enum": ["red", "blue", "yellow", "gold", "gen1", "gen2", "all"] } },
    "profile": { "enum": ["content", "overhaul", "total_conversion"] },
    "affects_link": { "type": "boolean" },
    "experimental": { "type": "boolean" },
    "permissions": { "type": "array", "uniqueItems": true, "items": { "enum": ["network", "filesystem", "engine_internals"] } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "conflicts": { "type": "array", "items": { "type": "string" } },
    "license": { "type": "string", "maxLength": 64 }
  }
}
